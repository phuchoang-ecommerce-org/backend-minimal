# Copy to a local, ignored .env file or export before using Compose / bootRun.
DB_PASSWORD=replace-with-a-local-secret
DB_URL=jdbc:postgresql://localhost:5432/marketplace
DB_RUNTIME_USER=marketplace_dev
DB_RUNTIME_PASSWORD=replace-with-a-local-secret
DB_MIGRATION_USER=marketplace_dev
DB_MIGRATION_PASSWORD=replace-with-a-local-secret
# Set only for an explicitly enabled local dev fixture run; values are password hashes.
DEV_FIXTURES_ENABLED=false
DEV_MEMBER_PASSWORD_HASH=
DEV_SELLER_PASSWORD_HASH=
DEV_ADMIN_PASSWORD_HASH=
